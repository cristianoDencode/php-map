{
    "name": "php-map/php-extractor",
    "description": "Extrator de AST do e-Cidade (nikic/php-parser) que emite JSONL para o php-map",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "PhpMap\\Extractor\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
