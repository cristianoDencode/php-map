# Ferramentas de desenvolvimento: configurações locais de cada máquina e estado efêmero por sessão
.*/settings.local.json
.*/hooks/state/

# Notas locais de contexto sobre o cofre de certificados (não é artefato da ferramenta)
/.notas-certificados/

